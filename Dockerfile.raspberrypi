# Native ARMv6 welle-cli build; use the checked-out fork, not upstream HEAD.
FROM tianon/raspbian:bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git pkg-config xxd ca-certificates \
    libmp3lame-dev libfftw3-dev libmpg123-dev libsoapysdr-dev \
    librtlsdr-dev libairspy-dev libasound2-dev libfaad-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN cmake -S . -B /tmp/welle-build \
      -DCMAKE_BUILD_TYPE=Release -DBUILD_WELLE_IO=OFF \
      -DRTLSDR=ON -DAIRSPY=ON -DSOAPYSDR=ON \
    && cmake --build /tmp/welle-build --parallel 2 \
    && /tmp/welle-build/welle-cli -h \
    && mkdir /out \
    && cp /tmp/welle-build/welle-cli /out/ \
    && ldd /tmp/welle-build/welle-cli > /out/runtime-dependencies.txt

FROM scratch AS export
COPY --from=build /out/ /build/
